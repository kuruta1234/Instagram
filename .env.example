# Anthropic APIキー(キャプション自動生成に使用)
# https://console.anthropic.com/ で発行できます
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 使用するモデル(省略時は claude-sonnet-5)
IGTOOL_CLAUDE_MODEL=claude-sonnet-5

# データ保存先(省略時は ./data)
IGTOOL_DATA_DIR=./data

# NGワードリストのパス(省略時は ./config/ng_words.txt)
IGTOOL_NG_WORDS_PATH=./config/ng_words.txt
