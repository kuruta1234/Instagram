# データ保存先(省略時は ./data)
IGTOOL_DATA_DIR=./data

# キャプション自動生成に使うClaude Code CLIのコマンド名(省略時は claude)
IGTOOL_CLAUDE_CLI_COMMAND=claude

# Claude Code CLI呼び出しのタイムアウト秒数(省略時は 180)
IGTOOL_CLAUDE_CLI_TIMEOUT=180

# --- Claude Code CLIが使えない場合のフォールバック ---
# 直接Anthropic APIを呼び出す。claude.aiのプラン(Free/Pro/Max等)に関係なく、
# APIキーさえあれば動作する(要: pip install anthropic)。
# https://console.anthropic.com/ で発行できる
ANTHROPIC_API_KEY=

# フォールバック時に使うモデル(省略時は claude-opus-5)
IGTOOL_ANTHROPIC_MODEL=claude-opus-5
